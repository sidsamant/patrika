{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ADK API Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/Scripts/adk.exe",
      "args": ["api_server", "agents/", "--port", "8001"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
