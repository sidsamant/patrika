            "type": "shell",
            "command": ".\\.venv\\Scripts\\Activate.ps1; cd ./agents ; adk web bulk_newsgenerator --port 8280;",
            "options": {
                "env": {
                    "OTEL_SERVICE_NAME": "adk-agent-service"
                },
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
                }
            },
            "group": "none",
