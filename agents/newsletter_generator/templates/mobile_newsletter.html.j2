<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f3efe7;
      color: #1f2933;
      font-family: Georgia, "Times New Roman", serif;
    }
    table {
      border-spacing: 0;
      border-collapse: collapse;
    }
    img {
      border: 0;
      display: block;
      max-width: 100%;
      height: auto;
    }
    .wrapper {
      width: 100%;
      background: #f3efe7;
      padding: 16px 0;
    }
    .container {
      width: 100%;
      max-width: 640px;
      margin: 0 auto;
      background: #fffaf2;
      border: 1px solid #dccfb9;
    }
    .hero {
      padding: 28px 24px 18px 24px;
      background: linear-gradient(180deg, #fbf2df 0%, #fffaf2 100%);
    }
    .hero h1 {
      margin: 0 0 10px 0;
      font-size: 28px;
      line-height: 1.2;
      color: #8c2f1f;
    }
    .hero p {
      margin: 0;
      color: #5b6b7a;
      font-size: 14px;
      line-height: 1.6;
    }
    .section-block {
      padding: 0 24px 12px 24px;
    }
    .section-title {
      margin: 22px 0 10px 0;
      font-size: 20px;
      line-height: 1.3;
      color: #1f2933;
      border-bottom: 1px solid #e3d8c6;
      padding-bottom: 8px;
    }
    .story-card {
      border: 1px solid #e7dccb;
      background: #fffdf9;
      margin: 0 0 18px 0;
    }
    .story-body {
      padding: 18px;
    }
    .story-title {
      margin: 0 0 10px 0;
      font-size: 18px;
      line-height: 1.35;
      color: #8c2f1f;
    }
    .story-meta {
      margin: 0 0 12px 0;
      color: #6b7280;
      font-size: 12px;
      line-height: 1.5;
    }
    .story-summary {
      margin: 0 0 12px 0;
      font-size: 15px;
      line-height: 1.7;
    }
    .fact-list {
      margin: 0;
      padding-left: 18px;
      font-size: 14px;
      line-height: 1.6;
    }
    .caption {
      margin: 8px 0 0 0;
      color: #6b7280;
      font-size: 12px;
      line-height: 1.5;
      font-style: italic;
    }
    .source-link {
      word-break: break-word;
      color: #8c2f1f;
      text-decoration: none;
    }
    .footer {
      padding: 18px 24px 28px 24px;
      color: #6b7280;
      font-size: 12px;
      line-height: 1.6;
    }
    @media only screen and (max-width: 640px) {
      .hero, .section-block, .footer {
        padding-left: 16px !important;
        padding-right: 16px !important;
      }
      .hero h1 {
        font-size: 24px !important;
      }
      .story-title {
        font-size: 17px !important;
      }
    }
    @media print {
      body {
        background: #ffffff;
      }
      .wrapper {
        padding: 0;
        background: #ffffff;
      }
      .container {
        border: 0;
        max-width: none;
        width: 100%;
      }
      .story-card {
        break-inside: avoid;
        page-break-inside: avoid;
      }
      a {
        color: #000000;
        text-decoration: none;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <table role="presentation" class="container" width="100%">
      <tr>
        <td class="hero">
          <h1>{{ title }}</h1>
          <p>Run timestamp: {{ run_timestamp }}<br>Total stories: {{ total_story_count }}<br>Sections: {{ sections|length }}</p>
        </td>
      </tr>
      {% for section in sections %}
      <tr>
        <td class="section-block">
          <h2 class="section-title">{{ section.name }}</h2>
          {% for story in section.stories %}
          <table role="presentation" class="story-card" width="100%">
            {% if story.image_path %}
            <tr>
              <td>
                <img src="{{ story.image_path }}" alt="{{ story.newsletter_title }}">
              </td>
            </tr>
            {% endif %}
            <tr>
              <td class="story-body">
                <h3 class="story-title">{{ story.newsletter_title }}</h3>
                <p class="story-meta">Score: {{ story.score }}{% if story.source_path %} | Source: <a class="source-link" href="{{ story.source_path }}">{{ story.source_path }}</a>{% endif %}</p>
                <p class="story-summary">{{ story.summary }}</p>
                {% if story.summary_facts %}
                <ul class="fact-list">
                  {% for fact in story.summary_facts %}
                  <li>{{ fact }}</li>
                  {% endfor %}
                </ul>
                {% endif %}
                {% if story.image_caption %}
                <p class="caption">{{ story.image_caption }}</p>
                {% endif %}
              </td>
            </tr>
          </table>
          {% endfor %}
        </td>
      </tr>
      {% endfor %}
      <tr>
        <td class="footer">
          Generated by Newsletter ADK. This HTML is mobile-first, email-friendly, and print-ready.
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
